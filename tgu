def build_markup(args):
    """--button 'ТЕКСТ|URL' / --button 'ТЕКСТ' → ReplyMarkup или None."""
    specs = getattr(args, "button", None)
    if not specs:
        return None
    kb = []
    for spec in specs:
        if "|" in spec:
            text, url = spec.split("|", 1)
            if not url:
                die("кнопка %r: пустой url (формат 'ТЕКСТ|URL')" % spec)
            kb.append(tl.KeyboardButtonUrl(text=text.strip() or url, url=url))
        else:
            text = spec.strip()
            if not text:
                die("пустая кнопка")
            kb.append(tl.KeyboardButton(text=text))
    if any(isinstance(b, tl.KeyboardButtonUrl) for b in kb) and \
            any(isinstance(b, tl.KeyboardButton) for b in kb):
        die("смешивать url-кнопки и текстовые в одном сообщении нельзя — "
            "используй два сообщения")
    if kb and isinstance(kb[0], tl.KeyboardButton):
        return tl.ReplyKeyboardMarkup(rows=[tl.KeyboardButtonRow(buttons=kb)],
                                      resize=True)
    rows = []
    for i in range(0, len(kb), 4):
        rows.append(tl.KeyboardButtonRow(buttons=kb[i:i + 4]))
    return tl.ReplyInlineMarkup(rows=rows)


