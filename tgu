    q.add_argument("--button", action="append", metavar="ТЕКСТ|URL",
                   help="кнопка: 'Подписаться|https://...' (url-кнопка) "
                        "или 'Вариант' (текстовая reply-кнопка); повтори для ряда")

    q = sub.add_parser("reply", help="быстрый ответ на сообщение")
    q.add_argument("chat"); q.add_argument("id", type=int)
    q.add_argument("text", nargs="*")
    q.add_argument("--silent", action="store_true")
    q.add_argument("--button", action="append", metavar="ТЕКСТ|URL")
    q.add_argument("--raw", action="store_true")

    q = sub.add_parser("edit", help="редактировать своё сообщение")
    q.add_argument("chat"); q.add_argument("id", type=int); q.add_argument("text", nargs="+")

    q = sub.add_parser("delete", aliases=["rm"], help="удалить сообщения")
    q.add_argument("chat")
    q.add_argument("ids", type=int, nargs="*", metavar="ID")
    q.add_argument("-l", "--last", type=int, metavar="N", help="последние N")
    q.add_argument("-m", "--mine", action="store_true", help="только свои")
    q.add_argument("--recover", action="store_true",
                   help="удалить только у себя (без revoke)")
    q.add_argument("-y", "--yes", action="store_true", help="без подтверждения")

    # ---- файлы
    q = sub.add_parser("push", aliases=["upload"], help="отправить файлы в чат")
    q.add_argument("chat"); q.add_argument("files", nargs="+")
    q.add_argument("-c", "--caption", nargs="*", help="подпись")
    q.add_argument("-p", "--as-photo", action="store_true", help="сжать как фото")
    q.add_argument("--reply", type=int, metavar="ID")
    q.add_argument("--silent", action="store_true")
    q.add_argument("-y", "--yes", action="store_true")

    q = sub.add_parser("pull", aliases=["download", "dl"], parents=[mf],
                       help="скачать медиа/файлы из чата")
    q.add_argument("chat")
    q.add_argument("-d", "--dest", metavar="DIR", help="куда (по умолчанию из tgu config)")
    q.add_argument("-n", "--dry-run", action="store_true", help="только показать список")

    # ---- кнопки
    q = sub.add_parser("click", help="нажать кнопку у сообщения "
                                     "(номер от 0 или текст кнопки)")
    q.add_argument("chat")
    q.add_argument("id", type=int)
    q.add_argument("button", help="номер или текст кнопки (можно частично)")

    # ---- прочее
    q = sub.add_parser("forward", aliases=["fw"], help="переслать сообщения")
    q.add_argument("chat"); q.add_argument("ids", type=int, nargs="+")
    q.add_argument("--to", required=True, help="куда переслать")

    q = sub.add_parser("mark", help="отметить чат прочитанным")
    q.add_argument("chat")
    q.add_argument("--up-to", type=int, metavar="ID", help="до какого id")

    q = sub.add_parser("pin", help="закрепить сообщение")
    q.add_argument("chat"); q.add_argument("id", type=int)
    q.add_argument("--notify", action="store_true")

    q = sub.add_parser("unpin", help="открепить (последнее или по id)")
    q.add_argument("chat"); q.add_argument("id", type=int, nargs="?")

    q = sub.add_parser("help", help="справка по команде")
    q.add_argument("topic", nargs="?")
    return ap


