async def cmd_pull(client, args):
    ent = await resolve(client, args.chat)
    cfg = load_cfg()
    dest = Path(os.path.expanduser(args.dest or cfg.get("download_dir",
                                                        str(DEFAULT_DL_DIR))))
    dest.mkdir(parents=True, exist_ok=True)
    msgs = await fetch_msgs(client, ent, args)
    have = [m for m in msgs if m.media and not isinstance(m, tl.MessageService)]
    if not have:
        p("нет медиа по заданным фильтрам")
        return
    total = 0
    paths = []
    for m in have:
        tag, fname = describe_media(m)
        if args.dry_run:
            p(dim("[%d] " % m.id) + cyan("[%s]" % tag) + " " + (fname or "<без имени>"))
            continue
        def _prog(cur, tot, _m=m):
            if tot:
                sys.stdout.write("\r%s %s %3d%%" %
                                 (dim("[%d]" % _m.id), cyan("[%s]" % tag),
                                  cur * 100 // tot))
                sys.stdout.flush()
        try:
            path = await m.download_media(file=str(dest), progress_callback=_prog)
            if path:
                if sys.stdout.isatty():
                    sys.stdout.write("\033[K\r")
                size = None
                try:
                    size = Path(path).stat().st_size
                except Exception:
                    pass
                total += size or 0
                paths.append(path)
                p(dim("[%d] " % m.id) + cyan("[%s]" % tag) + green(" → ") + path +
                  (" " + dim("(%s)" % human(size)) if size else ""))
        except FloodError:
            warn("флуд-лимит, остановка"); break
        except Exception as e:
            warn("не скачалось [%d]: %s" % (m.id, e))
    if not args.dry_run:
        p(green("✓ скачано %d файл(ов), %s → %s" % (len(paths), human(total), dest)))


