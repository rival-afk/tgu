def entity_name(e):
    if e is None:
        return "?"
    if getattr(e, "title", None):
        return e.title
    n = " ".join(x for x in (getattr(e, "first_name", None),
                             getattr(e, "last_name", None)) if x)
    return n or (e.username and "@" + e.username) or str(e.id)


def shutdown(client):
    """Корректно отключиться (sync-контекст): disconnect() сам завершает соединение."""
    try:
        client.disconnect()
    except Exception:
        pass


async def get_dialogs(client, limit=None):
    return [d async for d in client.iter_dialogs(limit=limit)]


def dialog_uname(d):
    u = getattr(d.entity, "username", None)
    return u.lower() if u else None


def fuzzy_find(dialogs, q):
    """Лучший диалог по подстроке в названии/@username/id."""
    q = q.lower().lstrip("#")
    cands = []
    for d in dialogs:
        name = (d.name or "").lower()
        un = dialog_uname(d)
        sid = str(d.id)
        score = 0
        if name == q:
            score = 6
        elif un == q or un == q.lstrip("@"):
            score = 5
        elif sid == q:
            score = 5
        elif name.startswith(q):
            score = 4
        elif q in name:
            score = 3
        elif un and (un.startswith(q.lstrip("@")) or q.lstrip("@") in un):
            score = 2
        if score:
            cands.append((score, d))
    cands.sort(key=lambda x: -x[0])
    return cands


async def resolve(client, ref):
    """Разрешить: 'me', число-ид, @username, t.me-ссылку, или подстроку имени."""
    if not ref or not ref.strip():
        die("нужно указать имя/юзернейм/ид чата (например: tgu read \"Друзья\" --last 10)")
    ref = ref.strip()
    low = ref.lower().lstrip("#")
    ds = None

    if low in ("me", "saved", "избранное", "saved messages"):
        return await client.get_entity("me")

    if "t.me" in ref:
        if "joinchat/" in ref or re.search(r"t\.me/\+", ref):
            try:
                return await client.get_entity(ref)
            except Exception:
                die("не удалось найти сущность по ссылке %s" % ref)
        m = T_LINK.search(ref)
        try:
            return await client.get_entity(m.group(1))
        except Exception:
            die("не удалось найти сущность по ссылке %s" % ref)

    if T_INT.fullmatch(ref):
        try:
            return await client.get_entity(int(ref))
        except Exception:
            die("нет сущности с id=%s (если это приватный чат — возьми id из `tgu chats`)" % ref)

    if ref.startswith("@"):
        ds = ds or await get_dialogs(client)
        for d in ds:
            un = dialog_uname(d)
            if un and un == ref[1:].lower():
                return d.entity
        try:
            return await client.get_entity(ref)
        except Exception:
            die("нет @-юзернейма %s" % ref)

    ds = ds or await get_dialogs(client)
    cands = fuzzy_find(ds, ref)
    best = [d for s, d in cands if s == cands[0][0]] if cands else []
    if not best:
        names = ", ".join(d.name or str(d.id) for d in ds[:10])
        die("чат по строке %r не найден. Примеры твоих чатов: %s" % (ref, names))
    if len(best) > 1:
        opts = "\n".join("  • %s (@%s, id %s)" % (d.name, dialog_uname(d) or "-", d.id)
                         for d in best[:8])
        die("под %r подходят несколько чатов, уточни:\n%s" % (ref, opts))
    return best[0].entity


def describe_media(msg):
    """(тег, имя_файла) для сообщения с медиа."""
    md = msg.media
    if not md:
        return "", None
    ts = tl
    if isinstance(md, ts.MessageMediaPhoto):
        return "фото", None
    if isinstance(md, ts.MessageMediaDocument):
        doc = md.document
        attrs = getattr(doc, "attributes", []) or []
        name = None
        for a in attrs:
            if getattr(a, "file_name", None):
                name = a.file_name
        for a in attrs:
            if isinstance(a, ts.DocumentAttributeAnimated):
                return "gif", name
            if isinstance(a, ts.DocumentAttributeSticker):
                return "стикер", name
            if isinstance(a, ts.DocumentAttributeVideo):
                return ("видеокружение" if a.round_message else "видео"), name
            if isinstance(a, ts.DocumentAttributeAudio):
                return ("голосовое" if a.voice else "аудио"), name
            if isinstance(a, ts.DocumentAttributeFilename) and not name:
                name = getattr(a, "file_name", None)
        return "документ", name
    if isinstance(md, ts.MessageMediaPoll):
        return "опрос", None
    if isinstance(md, ts.MessageMediaContact):
        return "контакт", None
    if isinstance(md, (ts.MessageMediaGeo, getattr(ts, "MessageMediaGeoLive", object))):
        return "геолокация", None
    if isinstance(md, ts.MessageMediaWebPage):
        return "ссылка", None
    if isinstance(md, getattr(ts, "MessageMediaDice", object)):
        return "кубик", None
    return "медиа", None


def _u16_to_py(text, u):
    """Индекс в python-строке по UTF-16-смещению Telegram."""
    if u <= 0:
        return 0
    c = 0
    for i, ch in enumerate(text):
        if c >= u:
            return i
        c += 2 if ord(ch) > 0xFFFF else 1
    return len(text)


def _ent_code(e):
    t = tl
    if isinstance(e, t.MessageEntityBold):
        return "1"
    if isinstance(e, t.MessageEntityItalic):
        return "3"
    if isinstance(e, t.MessageEntityUnderline):
        return "4"
    if isinstance(e, t.MessageEntityStrike):
        return "9"
    if isinstance(e, (t.MessageEntityCode, getattr(t, "MessageEntityInlineCode", object))):
        return "36"
    if isinstance(e, t.MessageEntityPre):
        return "32"
    if isinstance(e, t.MessageEntitySpoiler):
        return "2"
    if isinstance(e, (t.MessageEntityUrl, t.MessageEntityTextUrl)):
        return "34;4"
    if isinstance(e, (t.MessageEntityMention, t.MessageEntityMentionName)):
        return "34"
    if isinstance(e, (t.MessageEntityEmail, t.MessageEntityPhone)):
        return "4"
    if isinstance(e, (t.MessageEntityHashtag, t.MessageEntityCashtag,
                      getattr(t, "MessageEntityBotCommand", object))):
        return "1"
    return None


def ansi_render(text, entities):
    if not text:
        return text
    n = len(text)
    styles = [set() for _ in range(n)]
    for e in entities or []:
        code = _ent_code(e)
        if not code:
            continue
        s = _u16_to_py(text, e.offset)
        en = _u16_to_py(text, e.offset + e.length)
        for i in range(min(s, n), min(en, n)):
            styles[i].add(code)
    out = []
    cur = None
    buf = ""
    flush_sentinel = object()

    def flush(new):
        nonlocal cur, buf
        if buf:
            if cur:
                out.append("\033[" + ";".join(sorted(cur)) + "m" + buf + "\033[0m")
            else:
                out.append(buf)
        buf = ""
        cur = new

    cur = frozenset()
    for ch, st in zip(text, styles):
        fs = frozenset(st)
        if fs != cur:
            flush(fs)
        buf += ch
    flush(frozenset())
    return "".join(out)


def render_text(m, raw=False):
    """Текст сообщения: ANSI-стили из сущностей, сырой markdown или plain."""
    text = msg_text(m)
    if not text:
        return ""
    if raw:
        from telethon.extensions import markdown as _md
        return _md.unparse(text, m.entities)
    if _on():
        return ansi_render(text, m.entities)
    return text


def _rich_block_text(t):
    """Текст из Text* элемента rich_message (TextPlain/TextConcat/TextCustomEmoji/...)."""
    if t is None:
        return ""
    if hasattr(t, "texts"):          # TextConcat
        return "".join(_rich_block_text(x) for x in (t.texts or []))
    alt = getattr(t, "alt", None)    # TextCustomEmoji
    if alt is not None:
        return alt
    if hasattr(t, "text"):           # TextPlain, TextUrl, TextEmail, ...
        return t.text or ""
    return ""


def rich_message_text(m):
    """Текст «богатого» сообщения (rich_message) — новые посты, где message=''. """
    rm = getattr(m, "rich_message", None)
    if not rm:
        return ""
    lines = []
    for b in (rm.blocks or []):
        name = type(b).__name__
        if name == "PageBlockButtonRow":
            for btn in (getattr(b, "buttons", None) or []):
                bt = _rich_block_text(getattr(btn, "text", None)).strip()
                if not bt:
                    continue
                url = getattr(getattr(btn, "type", None), "url", None)
                lines.append("[кнопка] %s%s" % (bt, " (🔗 %s)" % url if url else ""))
        elif hasattr(b, "text"):
            s = _rich_block_text(getattr(b, "text", None)).strip()
            if s:
                lines.append(bold(s) if name.startswith("PageBlockHeading") else s)
    return "\n".join(lines)


def msg_text(m):
    """Весь читаемый текст сообщения: обычный или из rich_message."""
    return m.message or rich_message_text(m)


def btn_rows(msg):
    """Строки кнопок сообщения (для вывода) или None."""
    rm = getattr(msg, "reply_markup", None)
    rows = getattr(rm, "rows", None)
    if not rows:
        return None
    out = []
    for row in rows:
        cells = []
        for b in row.buttons:
            if isinstance(b, tl.KeyboardButtonUrl):
                cells.append(cyan(b.text) + dim("(🔗 %s)" % (b.url[:40])))
            elif isinstance(b, tl.KeyboardButtonCallback) or \
                    type(b).__name__ == "KeyboardButtonCallback":
                cells.append(bold(b.text) + dim("(кнопка)"))
            elif hasattr(b, "text"):
                cells.append(str(b.text))
            else:
                cells.append(dim(type(b).__name__))
        if cells:
            out.append("  ⌨ " + " │ ".join(cells))
    return "\n".join(out) if out else None


def _btn_kind(b):
    if isinstance(b, tl.KeyboardButtonUrl):
        return {"text": b.text, "kind": "url", "url": b.url}
    if type(b).__name__ == "KeyboardButtonCallback":
        data = getattr(b, "data", b"")
        try:
            data = data.decode("utf-8", "replace")
        except Exception:
            pass
        return {"text": b.text, "kind": "callback", "data": data}
    return {"text": getattr(b, "text", None), "kind": type(b).__name__}


def fmt_msg(msg, sender_name, raw=False):
    if isinstance(msg, tl.MessageService):
        act = type(getattr(msg, "action", None)).__name__
        return "%s %s" % (dim("[%s]" % msg.id), dim("* " + act))
    who = "Ты →" if msg.out else (sender_name or "id%s" % msg.sender_id)
    tag, fname = describe_media(msg)
    parts = [
        dim("[%d]" % msg.id),
        dim(fdate(msg.date)),
        bold(who),
    ]
    if msg.reply_to:
        parts.append(dim("⤶%s" % msg.reply_to.reply_to_msg_id))
    if tag:
        parts.append(cyan("[%s]" % tag))
    txt = render_text(msg, raw=raw)
    if txt:
        parts.append(txt)
    line = " ".join(parts)
    btns = btn_rows(msg)
    if btns:
        line += "\n" + btns
    return line


def msg_json(msg, sender_name):
    tag, fname = describe_media(msg)
    d = {
        "id": msg.id,
        "chat_id": msg.chat_id,
        "date": local(msg.date).isoformat() if msg.date else None,
        "out": bool(msg.out),
        "sender_id": msg.sender_id,
        "sender": sender_name,
        "text": msg_text(msg),
        "reply_to": getattr(getattr(msg, "reply_to", None), "reply_to_msg_id", None),
        "media": tag or None,
        "file": fname,
        "size": getattr(getattr(getattr(msg, "document", None) or getattr(msg, "photo", None), "size", {}), "size", None)
                if (tag in ("фото", "видео", "документ", "аудио", "голосовое", "gif")) else None,
        "edit_date": local(msg.edit_date).isoformat() if msg.edit_date else None,
        "buttons": [
            [_btn_kind(b) for b in row.buttons]
            for row in (getattr(getattr(msg, "reply_markup", None), "rows", None) or [])
        ] or None,
    }
    return d


def status_text(s):
    if s is None:
        return "-"
    t = tl
    if isinstance(s, t.UserStatusOnline):
        return "в сети"
    if isinstance(s, t.UserStatusOffline):
        return "был(а) " + fdate(s.was_online)
    if isinstance(s, t.UserStatusRecently):
        return "недавно"
    if isinstance(s, t.UserStatusLastWeek):
        return "на прошлой неделе"
    if isinstance(s, t.UserStatusLastMonth):
        return "в прошлом месяце"
    return "-"


MEDIA_FILTERS = {
    "photo": InputMessagesFilterPhotos,
    "video": InputMessagesFilterVideo,
    "doc": InputMessagesFilterDocument,
    "document": InputMessagesFilterDocument,
    "voice": InputMessagesFilterVoice,
    "audio": InputMessagesFilterMusic,
    "music": InputMessagesFilterMusic,
    "gif": InputMessagesFilterGif,
    "round": InputMessagesFilterRoundVideo,
    "url": InputMessagesFilterUrl,
}


def parse_when(s):
    if not s:
        return None
    t = s.strip().lower()
    now = dt.datetime.now()
    m = re.fullmatch(r"(\d+)\s*([dhwmчдн])", t)
    if m:
        n, u = int(m[1]), m[2]
        sec = {"h": 3600, "ч": 3600, "d": 86400, "д": 86400,
               "w": 604800, "н": 604800, "m": 60, "м": 60}[u]
        return (now - dt.timedelta(seconds=n * sec)).astimezone()
    if t in ("today", "сегодня"):
        return now.replace(hour=0, minute=0, second=0, microsecond=0).astimezone()
    if t in ("yesterday", "вчера"):
        return (now - dt.timedelta(days=1)).replace(
            hour=0, minute=0, second=0, microsecond=0).astimezone()
    try:
        if re.fullmatch(r"\d{4}-\d{2}-\d{2}", t):
            d = dt.datetime.fromisoformat(t + "T00:00")
        else:
            d = dt.datetime.fromisoformat(s)
        return d.astimezone()
    except ValueError:
        die("не понял дату %r (форматы: 2026-10-22, '2026-10-22 10:00', 3d/2w/5ч, yesterday)" % s)


def build_fetch(args):
    """Аргументы для iter_messages + пост-фильтры из общих опций read/pull."""
    kw = {}
    post = {}
    if getattr(args, "ids", None):
        kw["ids"] = args.ids
    else:
        kw["limit"] = None if args.all else (args.last or 20)
        frm = getattr(args, "from_", None)
        if args.mine:
            kw["from_user"] = "me"
        elif frm and (frm.startswith("@") or T_INT.fullmatch(frm) or frm.lower() == "me"):
            kw["from_user"] = frm
        elif frm:
            post["name"] = frm.lower()
        if getattr(args, "search", None):
            kw["search"] = args.search
        mt = getattr(args, "type", None)
        if mt:
            if mt in MEDIA_FILTERS:
                kw["filter"] = MEDIA_FILTERS[mt]()
            else:
                post["media_type"] = mt
    # пост-фильтры режут выборку сервера — расширяем окно, чтобы не потерять всё
    if (post.get("name") or post.get("media_type")) and kw.get("limit"):
        kw["limit"] = min(kw["limit"] * 10, 1000)
    if getattr(args, "since", None):
        post["since"] = parse_when(args.since)
    if getattr(args, "until", None):
        post["until"] = parse_when(args.until)
    if getattr(args, "incoming", False):
        post["incoming"] = True
    return kw, post


def keep_msg(msg, post):
    if isinstance(msg, tl.MessageService):
        return not post
    if post.get("incoming") and msg.out:
        return False
    if post.get("name"):
        sname = ""
        s = msg.sender
        if s:
            sname = (entity_name(s) or "").lower()
            #sender username check
            un = getattr(s, "username", None)
            if un:
                sname += " @" + un.lower()
        if post["name"] not in sname:
            return False
    d = msg.date
    if d:
        d = d.astimezone()
    if post.get("since") and (not d or d < post["since"]):
        return False
    if post.get("until") and (not d or d > post["until"]):
        return False
    if post.get("media_type"):
        tag, _ = describe_media(msg)
        if tag != post["media_type"]:
            return False
    return True


async def fetch_msgs(client, ent, args):
    kw, post = build_fetch(args)
    out = []
    async for m in client.iter_messages(ent, **kw):
        if m is None:
            continue
        if not keep_msg(m, post):
            continue
        out.append(m)
    out.reverse()  # старые сверху
    return out


