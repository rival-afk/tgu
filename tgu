async def cmd_click(client, args):
    ent = await resolve(client, args.chat)
    msgs = await client.get_messages(ent, ids=args.id)
    msg = msgs[0] if isinstance(msgs, list) else msgs
    if not msg:
        die("сообщение [%d] не найдено в %r" % (args.id, entity_name(ent)))
    rm = getattr(msg, "reply_markup", None)
    rows = getattr(rm, "rows", None)
    if not rows:
        die("у сообщения [%d] нет кнопок" % args.id)

    def flat_list():
        flat = [b for row in rows for b in row.buttons]
        return flat

    if isinstance(rm, tl.ReplyKeyboardMarkup):
        # reply-клавиатура: «нажать» = отправить текст кнопки
        for row in rows:
            for b in row.buttons:
                if args.button.lower() in getattr(b, "text", "").lower():
                    await client.send_message(ent, b.text)
                    p(green("✓ нажата reply-кнопка") +
                      dim(" %r → отправлен текст" % b.text))
                    return
        die("reply-кнопка %r не найдена; варианты: %s" %
            (args.button, " / ".join(getattr(b, "text", "?")
                                     for r in rows for b in r.buttons)))

    flat = flat_list()
    sel = args.button
    if T_INT.fullmatch(sel.strip()):
        i = int(sel)
        if not (0 <= i < len(flat)):
            die("нет кнопки №%d (всего %d). Варианты:\n  %s" %
                (i, len(flat), "\n  ".join(
                    "%d. %s" % (j, getattr(b, "text", "?"))
                    for j, b in enumerate(flat))))
        btn = flat[i]
    else:
        hits = [b for b in flat if sel.lower() in getattr(b, "text", "").lower()]
        if not hits:
            die("кнопка по тексту %r не найдена. Варианты:\n  %s" %
                (sel, "\n  ".join("%d. %s" % (j, getattr(b, "text", "?"))
                                  for j, b in enumerate(flat))))
        if len(hits) > 1:
            die("под %r несколько кнопок: %s — укажи номер" %
                (sel, " / ".join(getattr(b, "text", "?") for b in hits)))
        btn = hits[0]
    if isinstance(btn, tl.KeyboardButtonUrl):
        warn("это url-кнопка, у неё нечего «нажимать»: %s" % btn.url)
        return
    res = await msg.click(btn)
    p(green("✓ нажата кнопка %r" % getattr(btn, "text", "?")))
    if isinstance(res, tl.Message):
        p(dim("текст после нажатия: " + (res.message or "(пусто)")))
    p(green("✓ отправлено ") + dim("[%d] в %s" % (msg.id, entity_name(ent))))


