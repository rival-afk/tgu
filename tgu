       "forward": cmd_forward, "mark": cmd_mark, "pin": cmd_pin,
       "unpin": cmd_unpin, "click": cmd_click}


def human_time(s):
    if not s:
        return "некоторое время"
    if s < 60:
        return "%d сек" % s
    if s < 3600:
        return "%d мин" % (s // 60)
    return "%d ч %d мин" % (s // 3600, s % 3600 // 60)


def main():
    argv = list(sys.argv[1:])
    if argv and argv[0] in ALIASES:
        argv[0] = ALIASES[argv[0]]
    if argv and argv[0] in ("-h", "--help", "help"):
        if len(argv) > 1 and argv[1] in ALIASES:
            argv[1] = ALIASES[argv[1]]
    ap = build_parser()
    args = ap.parse_args(argv)
    if getattr(args, "no_color", False):
        os.environ["NO_COLOR"] = "1"
    if not getattr(args, "cmd", None):
        ap.print_help()
        return 0

    if args.cmd == "config":
        CFG_DIR.mkdir(parents=True, exist_ok=True)
        cfg = load_cfg()
        if not args.key:
            print(json.dumps(cfg, ensure_ascii=False, indent=2)); return 0
        if args.value is None:
            print(cfg.get(args.key, "")); return 0
        cfg[args.key] = args.value; save_cfg(cfg)
        print(green("✓ %s = %s" % (args.key, args.value))); return 0

    if args.cmd in FNS:
        args.fn = FNS[args.cmd]
    if not getattr(args, "fn", None):
        if getattr(args, "topic", None):
            topic = ALIASES.get(args.topic, args.topic)
            ap.parse_args([topic, "--help"])
        else:
            ap.print_help()
        return 0

    if getattr(args, "sync", False):
        args.fn(args)
        return 0

    client = build_client()
    if not SESSION_DB.exists():
        die("нет сессии — запусти: tgu login")
    loop = asyncio.new_event_loop()
    asyncio.set_event_loop(loop)
    try:
        loop.run_until_complete(client.connect())
        if not loop.run_until_complete(client.is_user_authorized()):
            die("сессия истекла/не авторизована — запусти: tgu login")
        loop.run_until_complete(args.fn(client, args))
    except FloodError as e:
        secs = getattr(e, "seconds", None) or (e.value if isinstance(e, object) else None)
        die("флуд-лимит: подожди %s" % human_time(getattr(e, "seconds", None)))
    except RPCError as e:
        die("ошибка Telegram: %s" % e)
    except (KeyboardInterrupt, EOFError):
        print(); sys.exit(130)
    finally:
        try:
            shutdown(client)
        except Exception:
            pass
        loop.close()
    return 0


if __name__ == "__main__":
    sys.exit(main())
