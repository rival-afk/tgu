# ───────────────────────────── argparse ─────────────────────────────

def build_parser():
    ap = argparse.ArgumentParser(
        prog=PROG, description="Удобный CLI-клиент Telegram (Telethon)",
        epilog=EXAMPLES, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--version", action="version", version="%s %s (telethon %s)"
                    % (PROG, VERSION, telethon_version))
    ap.add_argument("--no-color", action="store_true", help="без ANSI-цветов")
    sub = ap.add_subparsers(dest="cmd")

    # ---- служебные
    q = sub.add_parser("login", help="вход в аккаунт (первый запуск)")
    q.add_argument("--api-id", help="api_id с my.telegram.org")
    q.add_argument("--api-hash", help="api_hash с my.telegram.org")
    q.set_defaults(fn=cmd_login, sync=True)

    q = sub.add_parser("logout", help="выйти и удалить сессию")
    q.set_defaults(fn=cmd_logout, sync=True)

    q = sub.add_parser("status", help="статус авторизации")
    q.set_defaults(fn=cmd_status, sync=True)

    q = sub.add_parser("config", help="настройки (показать/прочитать/записать)")
    q.add_argument("key", nargs="?")
    q.add_argument("value", nargs="?")

    # ---- общие параметры фильтрации сообщений
    mf = argparse.ArgumentParser(add_help=False)
    mf.add_argument("-l", "--last", type=int, default=None,
                    help="сколько последних сообщений (по умолчанию 20)")
    mf.add_argument("-a", "--all", action="store_true", help="вообще все сообщения")
    mf.add_argument("--ids", type=int, nargs="+", metavar="ID",
                    help="конкретные id сообщений")
    mf.add_argument("-f", "--from", dest="from_", metavar="NAME",
                    help="от кого (@user, id, 'me' или часть имени)")
    mf.add_argument("-m", "--mine", action="store_true", help="только мои сообщения")
    mf.add_argument("--incoming", action="store_true", help="только чужие")
    mf.add_argument("--search", metavar="TEXT", help="поиск текста внутри чата")
    mf.add_argument("-s", "--since", metavar="WHEN",
                    help="начиная с: 2026-10-22, '2026-10-22 10:00', 3d, 2w, 5ч, yesterday")
    mf.add_argument("-u", "--until", metavar="WHEN", help="до указанной даты")
    mf.add_argument("-t", "--type", metavar="TYPE",
                    help="фото: photo, video, doc, voice, audio, gif, round, url, sticker")

    # ---- профили
    sub.add_parser("me", help="инфа о себе").set_defaults(fn=cmd_me)
    q = sub.add_parser("user", help="инфа о пользователе/канале/группе")
    q.add_argument("who", metavar="USER|ID|@USER|t.me-ссылка|часть_имени")
    sub.add_parser("contacts", help="список контактов").set_defaults(fn=cmd_contacts)

    # ---- чаты
    q = sub.add_parser("chats", aliases=["ls"], help="список чатов")
    q.add_argument("--limit", type=int, default=50, metavar="N")
    q.add_argument("-A", "--all", action="store_true", help="все чаты")
    q.add_argument("--unread", action="store_true", help="только с непрочитанными")
    q.add_argument("--type", choices=["u", "g", "c", "b"],
                   help="u=личные, g=группы, c=каналы, b=боты")
    q.add_argument("--json", action="store_true")

    # ---- чтение
    q = sub.add_parser("read", aliases=["r"], help="читать сообщения чата",
                       parents=[mf])
    q.add_argument("chat", help="имя / @user / id / 'me' (избранное)")
    q.add_argument("--ids-only", action="store_true", help="вывести только id")
    q.add_argument("--json", action="store_true")
    q.add_argument("--raw", action="store_true",
