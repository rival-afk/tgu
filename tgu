# ───────────────────────────── colors / output ─────────────────────────────

def _on():
    return sys.stdout.isatty() and os.environ.get("NO_COLOR") is None


def _c(code, s):
    return s if not _on() else "\033[%sm%s\033[0m" % (code, s)


def bold(s):  return _c("1", str(s))
def dim(s):   return _c("2", str(s))
def cyan(s):  return _c("36", str(s))
def green(s): return _c("32", str(s))
def yellow(s): return _c("33", str(s))
def red(s):   return _c("31", str(s))


def die(msg, code=1):
    print(red("ошибка: ") + str(msg), file=sys.stderr)
    sys.exit(code)


def warn(msg):
    print(yellow("предупреждение: ") + str(msg), file=sys.stderr)


def human(n):
    n = float(n or 0)
    for u in ("Б", "КиБ", "МиБ", "ГиБ"):
        if n < 1024 or u == "ГиБ":
            return ("%.1f %s" % (n, u)).replace(".0 ", " ")
        n /= 1024


def local(d):
    return dt.datetime.fromtimestamp(d.timestamp()) if d else None


def fdate(d):
    d = local(d)
    if not d:
        return "-"
    if d.date() == dt.date.today():
        return d.strftime("%H:%M:%S")
    if d.year == dt.datetime.now().year:
        return d.strftime("%d.%m %H:%M:%S")
    return d.strftime("%d.%m.%y %H:%M:%S")


# ───────────────────────────── config ─────────────────────────────

def load_cfg():
    try:
        return json.loads(CONFIG_FILE.read_text(encoding="utf-8"))
    except Exception:
        return {}


def save_cfg(cfg):
    CFG_DIR.mkdir(parents=True, exist_ok=True)
    CONFIG_FILE.write_text(
        json.dumps(cfg, ensure_ascii=False, indent=2), encoding="utf-8")


def api_creds(cfg):
    api_id = cfg.get("api_id") or os.environ.get("TG_API_ID")
    api_hash = cfg.get("api_hash") or os.environ.get("TG_API_HASH")
    if not api_id or not api_hash:
        die("нет API-ключей.\n"
            "  Получи api_id/api_hash на https://my.telegram.org → 'API development tools',\n"
            "  затем запусти:  tgu login  (или задай TG_API_ID / TG_API_HASH).")
    return int(api_id), str(api_hash)


def build_client():
    api_id, api_hash = api_creds(load_cfg())
    if not SESSION_DB.exists():
        die("нет сессии. Сначала войди:  tgu login")
    return TelegramClient(str(SESSION_FILE), api_id, api_hash)


