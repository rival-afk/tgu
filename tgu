def cmd_login(args):
    CFG_DIR.mkdir(parents=True, exist_ok=True)
    cfg = load_cfg()
    api_id = args.api_id or cfg.get("api_id") or os.environ.get("TG_API_ID")
    api_hash = args.api_hash or cfg.get("api_hash") or os.environ.get("TG_API_HASH")

    if not api_id or not api_hash:
        print("Нет API-ключей. Получи их на https://my.telegram.org → 'API development tools'\n")
        try:
            api_id = input(bold("api_id: ")).strip()
            api_hash = input(bold("api_hash: ")).strip()
        except (EOFError, KeyboardInterrupt):
            print(); sys.exit(1)
        if not (api_id.isdigit() and api_hash):
            die("api_id должен быть числом, api_hash — строкой")

    cfg["api_id"], cfg["api_hash"] = int(api_id), str(api_hash)
    save_cfg(cfg)

    loop = asyncio.new_event_loop()
    asyncio.set_event_loop(loop)
    client = TelegramClient(str(SESSION_FILE), int(api_id), str(api_hash))
    try:
        print(dim("— входим, следуй подсказкам (телефон → код из Telegram → 2FA, если есть)"))
        client.start()
        me = loop.run_until_complete(client.get_me())
        cfg["download_dir"] = cfg.get("download_dir", str(DEFAULT_DL_DIR))
        save_cfg(cfg)
        print(green("\n✓ Готово! Вошёл как: ") +
              bold(entity_name(me)) + dim(" (@%s, id %s)" %
                                          (me.username or "-", me.id)))
        print(dim("Дальше пробуй:\n  tgu chats\n  tgu read \"чат\" --last 10\n  tgu send chat Привет!"))
    finally:
        shutdown(client)
        loop.close()


def cmd_logout(args):
    client = build_client()
    loop = asyncio.new_event_loop()
    asyncio.set_event_loop(loop)
    try:
